generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Worker {
  id        Int           @id @default(autoincrement())
  name      String
  username  String        @unique
  password  String
  isActive      Boolean       @default(true)
  weeklyDayOffs Int           @default(1)
  createdAt     DateTime      @default(now())
  attendances   Attendance[]
}

model Attendance {
  id                Int       @id @default(autoincrement())
  workerId          Int
  date              String
  clockInAt         DateTime  @default(now())
  clockInPhoto      String
  clockInLat        Float?
  clockInLng        Float?
  clockOutAt        DateTime?
  clockOutPhoto     String?
  clockOutLat       Float?
  clockOutLng       Float?
  shiftType         String?
  scheduledStartAt  DateTime?
  latenessSeconds   Int?
  attendanceStatus  String?
  payStatus         String?
  worker            Worker    @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@index([date])
}
